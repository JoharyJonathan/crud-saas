extends layout 

block content 
    h1 New Role 

    form(action="/roles/create", method="POST") 
        div 
            label(for="name") Name 
            input(type="text" id="name" name="name" placeholder="Enter a name ...")

        div 
            label(for="description") Description 
            textarea(id="description" name="description" placeholder="Enter a description...")

        button(type='submit') Create