extend layout 

block content 
    h1 New Product 

    form(action="/products/create", enctype="multipart/form-data", method="POST")
        div 
            label(for="image") Product image 
            input(type="file" id="image" name="image") 

        div 
            label(for="name") Name 
            input(type="text" id="name" name="name" placeholder="Product name ...")

        div 
            label(for="description") Description 
            textarea(type="text" id="description" name="description" placeholder="Product description ...")

        div 
            label(for="stock") Stock 
            input(type="number" id="stock" name="stock" placeholder="Product stock ...")  

        div 
            label(for="price") Price 
            input(type="number" step="0.01" id="price" name="price" placeholder="Product price ...")

        button(type='submit') Create 